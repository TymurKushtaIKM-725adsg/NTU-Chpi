#include <iostream>
#include <string>
#include <cmath> //для sqrt та pow
using namespace std;

class Figure
{
protected:
    string name;

public:
    void set_name(string c)
    {
        name = c;
    }
    string get_name()
    {
        return name;
    }
};

class Circle : public Figure
{
private:
    double radius;

public:
    void set_radius(double r)
    {
        radius = r;
    }
    double calculate_area()
    {
        return 3.14 * radius * radius;
    }
    void show()
    {
        cout << "Circle (" << name << ") Area: " << calculate_area() << endl;
    }
};

class Rectangle : public Figure
{
private:
    double width, height;

public:
    void set_size(double w, double h)
    {
        width = w;
        height = h;
    }
    double calculate_area()
    {
        return width * height;
    }
    void show()
    {
        cout << " Rectangle (" << name << ") Area: " << calculate_area() << endl;
    }
};

class Triangle : public Figure
{
private:
    double a, b, c;

public:
    void set_sides(double side1, double side2, double side3)
    {
        a = side1; b = side2; c = side3;
    }

    double calculate_perimeter()
    {
        return a + b + c;
    }

    double calculate_area()
    {
        double p = calculate_perimeter() / 2;
        return sqrt(p * (p - a) * (p - b) * (p - c));
    }

    bool is_right_angled()
    {
        return (pow(a, 2) + pow(b, 2) == pow(c, 2) || pow(a, 2) + pow(c, 2) == pow(b, 2) || pow(b, 2) + pow(c, 2) == pow(a, 2));
    }

    void show()
    {
        cout << " Triangle (" << name << "):" << endl;
        cout << " Perimeter: " << calculate_perimeter() << endl;
        cout << " Area: " << calculate_area() << endl;
        cout << " Right-angled: " << (is_right_angled() ? "Yes" : "No") << endl;
    }
};

int main()
{
    Rectangle rect;
    rect.set_name("ABCD");
    rect.set_size(5, 10);
    rect.show();

    Triangle tri;
    tri.set_name("EFG");
    tri.set_sides(3, 4, 5);
    tri.show();

    return 0;
}
