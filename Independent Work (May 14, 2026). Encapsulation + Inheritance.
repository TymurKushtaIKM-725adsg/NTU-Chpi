#include <iostream>
#include <string>
using namespace std;

class Student
{
private:
    string name;
    int age;
    float average_mark;

public:
    void set_name(string n)
    {
        name = n;
    }

    string get_name()
    {
        return name;
    }

    void set_age(int a)
    {
        age = a;
    }

    int get_age()
    {
        return age;
    }

    void set_average_mark(float mark)
    {
        average_mark = mark;
    }

    float get_average_mark()
    {
        return average_mark;
    }

    void show()
    {
        cout << "Student: " << name << " \nAge: " << age << " \nAverage mark: " << average_mark << endl;
    }
};

int main()
{
    Student number1;

    number1.set_name("Oleg");
    number1.set_age(19);
    number1.set_average_mark(83.5);

    number1.show();

    return 0;
}

