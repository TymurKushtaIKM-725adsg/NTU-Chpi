#include <iostream>
using namespace std;

class Matrix
{
private:
    int data[5][5];

public:
    Matrix()
    {
        for (int i = 0; i < 5; i++)
        {
            for (int j = 0; j < 5; j++)
            {
                data[i][j] = 0;
            }
        }
    }

    Matrix(int startValue)
    {
        for (int i = 0; i < 5; i++)
        {
            for (int j = 0; j < 5; j++)
            {
                data[i][j] = startValue++;
            }
        }
    }

    void display() const
    {
        for (int i = 0; i < 5; i++)
        {
            for (int j = 0; j < 5; j++)
            {
                cout << data[i][j] << "\t";
            }
            cout << endl;
        }
        cout << endl;
    }

    Matrix operator+(const Matrix& other) const
    {
        Matrix temp;
        for (int i = 0; i < 5; i++)
        {
            for (int j = 0; j < 5; j++)
            {
                temp.data[i][j] = this->data[i][j] + other.data[i][j];
            }
        }
        return temp;
    }

    Matrix operator-(const Matrix& other) const
    {
        Matrix temp;
        for (int i = 0; i < 5; i++)
        {
            for (int j = 0; j < 5; j++)
            {
                temp.data[i][j] = this->data[i][j] - other.data[i][j];
            }
        }
        return temp;
    }

    bool operator==(const Matrix& other) const
    {
        for (int i = 0; i < 5; i++)
        {
            for (int j = 0; j < 5; j++)
            {
                if (this->data[i][j] != other.data[i][j])
                {
                    return false;
                }
            }
        }
        return true;
    }
};

int main()
{
    Matrix m1(1);  //Матриця 1 до 25
    Matrix m2(10); //Матриця 10 до 34

    cout << "Matrix 1:" << endl;
    m1.display();

    cout << "Matrix 2:" << endl;
    m2.display();

    //Демонстрація перевантаженого додавання
    Matrix m3 = m1 + m2;
    cout << "Addition result (m1 + m2):" << endl;
    m3.display();

    //Демонстрація перевантаженого віднімання
    Matrix m4 = m2 - m1;
    cout << "Subtraction result (m2 - m1):" << endl;
    m4.display();

    //Демонстрація перевантаженого порівняння
    cout << "Comparison result (m1 == m2):" << endl;
    if (m1 == m2)
    {
        cout << "Matrices are completely identical." << endl;
    }
    else
    {
        cout << "Matrices are not equal." << endl;
    }

    cout << "\nComparison result (m1 == m1):" << endl;
    if (m1 == m1)
    {
        cout << "Matrices are identical." << endl;
    }
    else
    {
        cout << "Matrices are not equal." << endl;
    }

    return 0;
}
